cabal-version: 3.0
name: asai-blog
version: 0.1.0.0
build-type: Simple

executable site
  main-is: site.hs
  hs-source-dirs: ., src
  other-modules:
    Site.Markdown
    Site.Page
    Site.Views
    Site.Styles
    Site.Styles.Article
    Site.Styles.Base
    Site.Styles.Code
    Site.Styles.Loading
    Site.Styles.Print
    Site.Styles.Theme
  default-language: Haskell2010
  ghc-options: -Wall -threaded
  build-depends:
    base >= 4.18 && < 5,
    hakyll >= 4.16 && < 4.17,
    pandoc >= 3.1 && < 3.9,
    pandoc-types >= 1.23 && < 1.24,
    aeson >= 2.1 && < 2.3,
    blaze-html >= 0.9 && < 0.10,
    clay >= 0.16 && < 0.17,
    bytestring,
    text,
    time,
    filepath
